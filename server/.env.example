# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:3000

# MongoDB - Choose ONE option:
# Option 1: Local MongoDB
MONGODB_URI=mongodb://localhost:27017/ats-analyzer

# Option 2: MongoDB Atlas (Cloud)
# MONGODB_URI=your-mongodb-atlas-connection-string-here

# JWT Secret - CHANGE THIS to a random string in production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Gemini AI API Key
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Email Configuration (Optional - for sending analysis reports)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password-here
EMAIL_FROM=ATS Analyzer <noreply@atsanalyzer.com>

# Instructions:
# 1. Copy this file to .env (in the same directory)
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit the .env file to GitHub (it's in .gitignore)
